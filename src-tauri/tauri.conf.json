{
  "productName": "Deskly",
  "version": "0.1.0",
  "identifier": "com.deskly.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Deskly",
        "url": "index.html",
        "width": 440,
        "height": 720,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "minWidth": 400,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}